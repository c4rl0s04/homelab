# Host-specific values. Copy to hosts/<host>.env (ignored by Git) and adjust.
# Only this file changes when the homelab moves to another machine.

# Application data for every stack: ${DATA_ROOT}/<stack>/...
DATA_ROOT=/srv/homelab
# Bulk media (films, series), usually a separate disk.
MEDIA_ROOT=/mnt/media

PUID=1000
PGID=1000
TZ=Europe/Madrid

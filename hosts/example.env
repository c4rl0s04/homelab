# Host-specific values. Copy to hosts/<host>.env (ignored by Git) and adjust.
# Only this file changes when the homelab moves to another machine.

# Application data for every stack: ${DATA_ROOT}/<stack>/...
DATA_ROOT=/srv/homelab
# Bulk media: folder holding downloads/ and media/ (films). Usually a separate disk.
MEDIA_ROOT=/mnt/media

# Backup repositories, on a different physical disk than DATA_ROOT.
BACKUP_ROOT=/mnt/backups
# Transitional: old media stack folder, backed up (without data/) until media migrates.
LEGACY_MEDIA_ROOT=/srv/legacy/streaming

# Optional host ports for infra admin UIs.
# DOCKHAND_PORT=3001
# ADGUARD_UI_PORT=3000
# NPM_ADMIN_PORT=81

PUID=1000
PGID=1000
TZ=Europe/Madrid

# Set these as Dockhand stack variables, not in a committed file.

# Host values (same as hosts/<host>.env)
DATA_ROOT=E:/homelab/data
TZ=Europe/Madrid

# Secret: encrypts stored credentials. Generate once with `openssl rand -hex 32`;
# losing it makes encrypted data unreadable.
TREK_ENCRYPTION_KEY=change-me

# Optional
TREK_PORT=3002
TREK_ALLOWED_ORIGINS=http://127.0.0.1:3002

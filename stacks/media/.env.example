# Set these as Dockhand stack variables, not in a committed file.

# Host values
DATA_ROOT=<data-root>
# Folder that holds downloads/ and media/ (films). Large: never copied into DATA_ROOT.
MEDIA_ROOT=<old-project>/data
TZ=Europe/Madrid
PUID=1000
PGID=1000

# Secrets (mark as secret in Dockhand)
PROTON_WG_PRIVATE_KEY=change-me
QBIT_API_KEY=change-me
